# Environment Variables untuk FEWS Supabase Backend
# Copy file ini ke .env dan isi nilai yang sesuai

# ═══════════════════════════════════════════════════════════
# DATABASE SUPABASE
# ═══════════════════════════════════════════════════════════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ═══════════════════════════════════════════════════════════
# API SECURITY
# ═══════════════════════════════════════════════════════════
# ⚠️ PENTING: Harus sama dengan API_KEY di program ESP32!
# ESP32 program: const char* API_KEY = "fews2026";
API_KEY=fews2026

# ═══════════════════════════════════════════════════════════
# PRODUCTION
# ═══════════════════════════════════════════════════════════
NODE_ENV=production
